# Captures may contain sensitive metadata and can be very large.
captures/*
!captures/.gitkeep
*.pcap
*.pcapng
*.cap

# Generated reports and local persistent state
exports/*
!exports/.gitkeep
data/*
!data/.gitkeep

# Locally cloned upstream capture backend
# Installed by scripts/setup_rvi_capture.py
tools/rvi_capture/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
